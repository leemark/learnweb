{
  "name": "learnweb",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node generate.mjs",
    "predev": "node generate.mjs",
    "prestart": "node generate.mjs",
    "prebuild": "node generate.mjs",
    "dev": "node --watch dev-server.mjs",
    "start": "node dev-server.mjs",
    "build": "node build.mjs",
    "check": "node check.mjs",
    "test": "node smoke-test.mjs --skip-isolation",
    "test:quality": "node resilience-test.mjs && node ux-test.mjs",
    "test:isolation": "node smoke-test.mjs",
    "test:all": "node smoke-test.mjs --skip-isolation && node smoke-test.mjs --browser firefox --skip-isolation && node smoke-test.mjs --browser webkit --skip-isolation && npm run test:quality"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "baseline 2024"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1"
  }
}
